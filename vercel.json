{
  "buildCommand": "pnpm install && vite build",
  "outputDirectory": "dist/public",
  "installCommand": "npm i -g pnpm && pnpm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "${VITE_API_URL}/api/:path*"
    },
    {
      "source": "/((?!assets|icons|splash|favicon|manifest|robots|sitemap).*)",
      "destination": "/index.html"
    }
  ]
}
